 }
+extern void a03_sample_task(const char *, int, task_t);
+static int
+a03_sample_proc(proc_t p, __unused void *arg)
+{
+    char name[32];
+    proc_name(proc_pid(p), name, sizeof(name));
+    if (strcmp(name, "SpringBoard") && strcmp(name, "backboardd")) return PROC_RETURNED;
+    task_t task = proc_task(p);
+    if (task != TASK_NULL) a03_sample_task(name, proc_pid(p), task);
+    return PROC_RETURNED;
+}
+
+static void
+a03_sample_worker(__unused void *arg, __unused wait_result_t wr)
+{
+    extern int hz;
+    static int channel;
+    tsleep(&channel, PZERO, "a03sample", 180 * hz);
+    for (unsigned i = 0; i < 4; i++) {
+        printf("A03 SAMPLE begin %u\n", i);
+        proc_iterate(PROC_ALLPROCLIST, a03_sample_proc, NULL, NULL, NULL);
+        tsleep(&channel, PZERO, "a03sample", 120 * hz);
+    }
+}
+
+void a03_gui_sample_start(void);
+void
+a03_gui_sample_start(void)
+{
+    uint32_t enabled = 0;
+    PE_parse_boot_argn("a03_sample", &enabled, sizeof(enabled));
+    if (enabled != 1) return;
+    thread_t thread;
+    kern_return_t kr = kernel_thread_start(a03_sample_worker, NULL, &thread);
+    if (kr == KERN_SUCCESS) thread_deallocate(thread);
+    printf("A03 SAMPLE start %d\n", kr);
+}
