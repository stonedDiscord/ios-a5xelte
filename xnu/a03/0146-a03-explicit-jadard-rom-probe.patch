+ a03_touch_w32((void *)a03_touch_apb,0x1000,0x100);
+ a03_touch_w32((void *)a03_touch_clk,0x58,clock&~0x703u);
+ IODelay(10);
+ if(!(a03_touch_r32((void *)a03_touch_apb,0)&0x100)||
+     (a03_touch_r32((void *)a03_touch_clk,0x58)&0x703)) {
+  printf("A03 TOUCH clock readback failed\n");goto restore_clock;
