+/* Single-core A03 console spool. Both producer and consumer mask IRQs. */
+#define A03_LOG_SIZE (256u * 1024u)
+static unsigned char a03_log[A03_LOG_SIZE];
+static unsigned a03_log_head, a03_log_tail;
+unsigned a03_console_read(unsigned char *, unsigned);
+unsigned
+a03_console_read(unsigned char *dst, unsigned capacity)
+{
+    boolean_t irq = ml_set_interrupts_enabled(FALSE);
+    unsigned n = 0;
+    while (n < capacity && a03_log_tail != a03_log_head) {
+        dst[n++] = a03_log[a03_log_tail++ % A03_LOG_SIZE];
+    }
+    ml_set_interrupts_enabled(irq);
+    return n;
+}
+static void
+a03_console_append(uint8_t c)
+{
+    boolean_t irq = ml_set_interrupts_enabled(FALSE);
+    if (a03_log_head - a03_log_tail == A03_LOG_SIZE) {
+        a03_log_tail++;
+    }
+    a03_log[a03_log_head++ % A03_LOG_SIZE] = c;
+    ml_set_interrupts_enabled(irq);
+}
+#endif
