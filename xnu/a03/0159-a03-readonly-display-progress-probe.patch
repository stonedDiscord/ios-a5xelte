+/* Independent relaxed atomic fields; this observer never takes driver locks. */
+struct A03DisplayStats {
+    uint64_t vsyncEntered, vsyncDone, vsyncAt;
+    uint64_t swapEntered, swapDone, swapAt, copies, copyAt;
+    uint64_t notifyAttempt, notifyOK, notifyError, notifySkipped, notifyAt, lastError;
+};
+static A03DisplayStats a03_display_stats;
+static inline uint64_t a03_fb_read(const uint64_t *p) { return __atomic_load_n(p, __ATOMIC_RELAXED); }
+static inline void a03_fb_inc(uint64_t *p) { __atomic_add_fetch(p, 1, __ATOMIC_RELAXED); }
+static inline void a03_fb_set(uint64_t *p, uint64_t v) { __atomic_store_n(p, v, __ATOMIC_RELAXED); }
+extern "C" void a03_display_probe(void);
+extern "C" void a03_display_probe(void) {
+    const A03DisplayStats *s = &a03_display_stats;
+    IOLog("A03 DISPLAY now=%llu independent-fields absolute-ticks\n", mach_absolute_time());
+    IOLog("A03 DISPLAY vsync entered=%llu done=%llu last=%llu\n",
+        a03_fb_read(&s->vsyncEntered), a03_fb_read(&s->vsyncDone), a03_fb_read(&s->vsyncAt));
+    IOLog("A03 DISPLAY swap entered=%llu done=%llu last=%llu copies=%llu copy-last=%llu\n",
+        a03_fb_read(&s->swapEntered), a03_fb_read(&s->swapDone), a03_fb_read(&s->swapAt),
+        a03_fb_read(&s->copies), a03_fb_read(&s->copyAt));
+    IOLog("A03 DISPLAY notify attempts=%llu ok=%llu errors=%llu skipped=%llu last=%llu error=0x%llx\n",
+        a03_fb_read(&s->notifyAttempt), a03_fb_read(&s->notifyOK), a03_fb_read(&s->notifyError),
+        a03_fb_read(&s->notifySkipped), a03_fb_read(&s->notifyAt), a03_fb_read(&s->lastError));
+}
