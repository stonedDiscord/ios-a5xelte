 	    "/Library/Wallpaper/DefaultWallpapers~iphone.plist",
 	    "/Library/Wallpaper/DefaultWallpapers~ipod.plist", "DefaultWallpapers~iphone.plist");
+	a03_install_wallpaper_screen_class(root);
 }
