+        printf("A03 eMMC: request FLUSH FAILED int=%x r1=%x; disabled\n",rd(0x30),response);
+        return EIO;
+    }
+    wr(0x30,rd(0x30)&0xffff8033);wr(0x34,enable);wr(0x38,signal);
+    return 0;
+}
