+    if(ok) {
+        wr(0x30,rd(0x30)&0xffff8033);
+        wr(8,ae.rca);wr(0xc,0x0d1a0000);
+        ok=poll(1);response=rd(0x10);
+        if((response&0xffffe180u)!=0x100||(response&0x1e00)!=0x800)ok=false;
+    }
+    if(rd(0x24)&3)ok=false;
+    if(!ok) {
