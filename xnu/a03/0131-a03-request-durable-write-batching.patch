+static int data_flush_cache(void) {
+    if(!ae.cache_enabled)return 0;
+    if(ae.poisoned||(rd(0x24)&3)||rd(0x30))return EIO;
+    uint32_t enable=rd(0x34),signal=rd(0x38);
+    wr(0x38,0);wr(0x34,enable|0x037f8033);
