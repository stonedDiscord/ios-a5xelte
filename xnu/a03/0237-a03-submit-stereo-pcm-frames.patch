--- a/bsd/dev/a03_usb_console.c
+++ b/bsd/dev/a03_usb_console.c
@@ -372,6 +372,24 @@
 a03_audio_scene_probe(void)
 {
  if (!a03_audio_scene_start()) a03_audio_scene_stop();
+}
+
+/*
+ * AP01 uses L16 format. Submit whole stereo frames and stop as soon as
+ * either channel is full so both FIFOs advance by the same amount.
+ */
+static unsigned
+a03_audio_submit_pcm(vm_offset_t vbc, const uint32_t *frames, unsigned count)
+{
+ const uint32_t full = 1U << 19;
+ unsigned submitted = 0;
+ while (submitted < count) {
+  if ((a03_audio_read(vbc, 0x34) | a03_audio_read(vbc, 0x38)) & full) break;
+  uint32_t frame = frames[submitted++];
+  a03_audio_write(vbc, 0, frame & 0xffff);
+  a03_audio_write(vbc, 4, frame >> 16);
+ }
+ return submitted;
 }

