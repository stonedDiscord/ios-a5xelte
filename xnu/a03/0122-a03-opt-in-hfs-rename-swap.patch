+/* A03 lab root only: HFS implements atomic file exchange, not RENAMEX. */
+static int
+a03_hfs_rename_swap(int error, vfs_rename_flags_t flags, vnode_t from,
+    vnode_t to, vfs_context_t ctx)
+{
+	uint32_t enabled = 0, writable = 0;
+	mount_t mp;
+	static unsigned reports;
+
+	if (error != ENOTSUP || flags != VFS_RENAME_SWAP ||
+	    from == NULLVP || to == NULLVP || from == to ||
+	    !vnode_isreg(from) || !vnode_isreg(to)) {
+		return error;
+	}
+	mp = vnode_mount(from);
+	if (mp == NULL || mp != vnode_mount(to) ||
+	    !(mp->mnt_flag & MNT_ROOTFS) || (mp->mnt_flag & MNT_RDONLY) ||
+	    strcmp(mp->mnt_vfsstat.f_fstypename, "hfs") != 0 ||
+	    strcmp(mp->mnt_vfsstat.f_mntfromname, "/dev/a03userdata0") != 0) {
+		return error;
+	}
+	PE_parse_boot_argn("a03_hfs_swap", &enabled, sizeof(enabled));
+	PE_parse_boot_argn("a03emmc_rw", &writable, sizeof(writable));
+	if (enabled != 1 || writable != 1) {
+		return error;
+	}
+	/* Existing HFS journal/locking/error handling remains authoritative. */
+	error = VNOP_EXCHANGE(from, to, 0, ctx);
+	if (__atomic_fetch_add(&reports, 1, __ATOMIC_RELAXED) < 32) {
+		printf("A03 HFS: root regular-file RENAME_SWAP exchange error=%d\n", error);
+	}
+	return error;
+}
