+/* Explicit volatile UTC sync through the opted-in serialized USB worker.
+ * No RTC/PMIC access and no fixed compile-time date. Host supplies Unix UTC.
+ */
+static void a03_probe_time(const char *command) {
+ if(strcmp(command,"status")) {
+  const char *s=command;uint64_t epoch;
+  if(!a03_probe_number(&s,&epoch,10)||!a03_probe_end(s)||
+      epoch<1577836800ULL||epoch>4102444799ULL) {
+   printf("A03 PROBE time rejected; status or Unix UTC seconds2020..2099\n");return;
+  }
+  clock_set_calendar_microtime((clock_sec_t)epoch,0);
+ }
+ clock_sec_t secs;clock_usec_t us;
+ clock_get_calendar_microtime(&secs,&us);
+ printf("A03 PROBE time UTC=%llu usec=%u volatile; hardware RTC not implemented\n",
+     (unsigned long long)secs,(unsigned)us);
+}
