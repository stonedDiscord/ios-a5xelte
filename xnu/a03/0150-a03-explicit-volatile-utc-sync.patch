  else if(!strcmp(command,"help"))
-  printf("A03 PROBE help: ping ps vm io creds PID threads PID sample PID mem PID HEXADDR HEXCOUNT<=100; stat|acl /private/var/PATH; input status|home|swipeup\n");
+  printf("A03 PROBE help: ping ps vm io creds PID threads PID sample PID mem PID HEXADDR HEXCOUNT<=100; stat|acl /private/var/PATH; input status|home|swipeup; time status|UNIX_UTC_SECONDS\n");
+ else if(!strncmp(command,"time ",5))a03_probe_time(command+5);
  else if(!strncmp(command,"touch ",6))a03_touch_probe(command+6);
  else if(!strncmp(command,"input ",6))a03_probe_input(command+6);
  else if(!strncmp(command,"stat ",5))a03_probe_stat(command+5, false);
