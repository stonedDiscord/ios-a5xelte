--- a/bsd/dev/a03_usb_console.c
+++ b/bsd/dev/a03_usb_console.c
@@ -651,6 +651,28 @@
 /* Shared ADI ownership: USB supply setup finishes before workers start.
  * No arbitrary PMIC API or expansion of the USB write allowlist. */
 static volatile unsigned adi_runtime_busy;
+
+/* SC2730 audio-codec@1000, fixed analog registers from sprd-codec.h. */
+void a03_audio_codec_probe(void);
+void
+a03_audio_codec_probe(void)
+{
+ uint32_t power, speaker, depop;
+ if (!adi || !__sync_bool_compare_and_swap(&adi_runtime_busy, 0, 1)) {
+  printf("A03 AUDIO codec: ADI unavailable\n");
+  return;
+ }
+ int ok = adi_read(0x1000, &power) && adi_read(0x10ac, &speaker) &&
+     adi_read(0x11b0, &depop);
+ __sync_lock_release(&adi_runtime_busy);
+ if (ok) {
+  printf("A03 AUDIO codec: PMU0=%04x CDC14=%04x STS11=%04x\n",
+      power, speaker, depop);
+ } else {
+  printf("A03 AUDIO codec: ADI read failed\n");
+ }
+}
