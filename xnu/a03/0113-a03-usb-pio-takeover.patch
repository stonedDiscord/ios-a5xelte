+/* Linux sprd_musbhsdma.h:30 channels; Download may leave RX DMA active.
+ * This console is PIO-only. Disable channel enable before touching FIFOs. */
+static int pio_takeover(void) {
+ for(unsigned channel=0;channel<30;channel++) {
+  volatile uint32_t *cfg=(volatile uint32_t *)(usb+0x1c04+channel*0x20);
+  *cfg&=~1u;__asm__ volatile("dsb sy" ::: "memory");
+  if(*cfg&1)return 0;
+ }
+ /* Clear endpoint DMA request/mode, then flush twice as Linux gadget does. */
+ for(unsigned ep=1;ep<=2;ep++) {
+  ep_write(ep,2,0);ep_write(ep,6,0);
+ }
+ return 1;
+}
 static void endpoints(void) {
