  if (!a03_audio_exchange(A03_AUDIO_VBC_GET, 0, UINT32_MAX, params, 3, &status)) {
   printf("A03 AUDIO VBC: GET reply status=%08x fifo=%08x\n", status, params[2]);
  }
+}
+
+/* Stock 4H10 VBC scene NORMAL_AP01, playback, DAC0 and ADC0. */
+void a03_audio_scene_probe(void);
+void
+a03_audio_scene_probe(void)
+{
+ enum {
+  ADC_SOURCE = 52, DAC_OUT = 84, TX_PORT = 100, RX_PORT = 124,
+  PORT_DATA = 156, TX_WIDTH = 196, TX_POLARITY = 220,
+  RX_WIDTH = 244, RX_POLARITY = 276, IIS_MASTER = 324, MIXER = 488,
+  IV_ADC = 580, MASTER_SELECT = 584, VOICE_RECORD = 616
+ };
+ uint32_t payload[620 / sizeof(uint32_t)] = {0};
+ uint32_t status = 0;
+ for (unsigned i = 0; i < 4; i++) {
+  payload[ADC_SOURCE / 4 + i * 2] = i;
+  payload[RX_PORT / 4 + i * 2] = i;
+  payload[RX_PORT / 4 + i * 2 + 1] = i == 3 ? 3 : 1;
+  payload[RX_WIDTH / 4 + i * 2] = i;
+  payload[RX_WIDTH / 4 + i * 2 + 1] = i != 3;
+  payload[RX_POLARITY / 4 + i * 2] = i;
+  payload[MASTER_SELECT / 4 + i * 2] = i;
+ }
+ for (unsigned i = 0; i < 3; i++) {
+  payload[TX_PORT / 4 + i * 2] = i;
+  payload[TX_PORT / 4 + i * 2 + 1] = i;
+  payload[TX_WIDTH / 4 + i * 2] = i;
+  payload[TX_WIDTH / 4 + i * 2 + 1] = i == 0;
+  payload[TX_POLARITY / 4 + i * 2] = i;
+ }
+ for (unsigned i = 0; i < 5; i++) {
+  payload[PORT_DATA / 4 + i * 2] = i;
+  payload[PORT_DATA / 4 + i * 2 + 1] = i < 3 ? i : 0;
+  payload[MIXER / 4 + i * 3 + 1] = i;
+ }
+ payload[DAC_OUT / 4 + 2] = 1;
+ payload[IIS_MASTER / 4] = 1;
+ payload[IV_ADC / 4] = 1;
+ payload[VOICE_RECORD / 4] = 1;
+ int error = a03_audio_exchange(4, 0, 0, payload, sizeof(payload) / 4, &status);
+ printf("A03 AUDIO scene: startup error=%d status=%08x\n", error, status);
+ if (error) return;
+
+ memset(payload, 0, sizeof(payload));
+ status = 0;
+ error = a03_audio_exchange(5, 0, 0, payload, sizeof(payload) / 4, &status);
+ printf("A03 AUDIO scene: shutdown error=%d status=%08x\n", error, status);
 }
 
