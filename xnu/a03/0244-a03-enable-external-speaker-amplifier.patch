 /* SC2730 audio-codec@1000, fixed analog registers from sprd-codec.h. */
 void a03_audio_codec_probe(void);
+/* SM-A035G live DT: active-high AP GPIO40, general speaker music mode 10. */
+#define A03_SPK_PA_BIT (1u << 8)
+
+static vm_offset_t
+a03_speaker_amp_start(uint32_t saved[4])
+{
+ static vm_offset_t aon, gpio;
+ if (!aon) aon = ml_io_map(0x64000000, 0x2000);
+ if (!gpio) gpio = ml_io_map(0x641b0000, 0x1000);
+ if (!aon || !gpio) return 0;
+
+ /* GPIO_EB set alias, shared with the physical key driver. */
+ *(volatile uint32_t *)(aon + 0x1004) = 1u << 1;
+ __asm__ volatile("dsb sy" ::: "memory");
+ if (!(a03_audio_read(aon, 4) & (1u << 1))) return 0;
+
+ vm_offset_t bank = gpio + 2 * 0x80;
+ saved[1] = a03_audio_read(bank, 4);
+ a03_audio_update(bank, 4, A03_SPK_PA_BIT, A03_SPK_PA_BIT);
+ saved[0] = a03_audio_read(bank, 0);
+ saved[2] = a03_audio_read(bank, 8);
+ saved[3] = a03_audio_read(bank, 0x28);
+ a03_audio_update(bank, 0, A03_SPK_PA_BIT, 0);
+ a03_audio_update(bank, 8, A03_SPK_PA_BIT, A03_SPK_PA_BIT);
+ a03_audio_update(bank, 0x28, A03_SPK_PA_BIT, 0);
+ IOSleep(1);
+
+ boolean_t interrupts = ml_set_interrupts_enabled(FALSE);
+ for (unsigned pulse = 0; pulse < 10; pulse++) {
+  a03_audio_update(bank, 0, A03_SPK_PA_BIT, 0);
+  IODelay(2);
+  a03_audio_update(bank, 0, A03_SPK_PA_BIT, A03_SPK_PA_BIT);
+  IODelay(2);
+ }
+ ml_set_interrupts_enabled(interrupts);
+ IOSleep(10);
+ return bank;
+}
+
