+/* Runs in the dying initproc thread: copyin uses its still-live user map. */
+extern int a03_usb_debug_command(char *, unsigned);
+static int
+a03_debug_hex(const char **input, uint64_t *value)
+{
+    const char *s=*input;
+    while(*s==' ')s++;
+    if(s[0]=='0' && (s[1]=='x'||s[1]=='X'))s+=2;
+    unsigned digits=0;uint64_t v=0;
+    for(;;) {
+        unsigned n;
+        if(*s>='0'&&*s<='9')n=*s-'0';
+        else if(*s>='a'&&*s<='f')n=*s-'a'+10;
+        else if(*s>='A'&&*s<='F')n=*s-'A'+10;
+        else break;
+        if(++digits>16)return 0;
+        v=(v<<4)|n;s++;
+    }
+    if(!digits)return 0;
+    *input=s;*value=v;return 1;
+}
+void
+a03_init_debug_hold(int pid)
+{
+    uint32_t enabled=0;
+    PE_parse_boot_argn("a03debug_hold",&enabled,sizeof(enabled));
+    if(pid!=1 || enabled!=1)return;
+    printf("A03 DEBUG: initproc exit paused; USB commands: help regs bt mem HEX [HEXCOUNT] panic\n");
+    for(;;) {
+        char command[128];
+        if(!a03_usb_debug_command(command,sizeof(command))) { IOSleep(10);continue; }
+        if(!strcmp(command,"panic")) { printf("A03 DEBUG: continuing fatal exit\n");return; }
+        if(!strcmp(command,"regs")||!strcmp(command,"bt")) { a03_init_trap_log(pid); }
+        else if(!strncmp(command,"mem ",4)) {
+            const char *s=command+4;uint64_t addr=0,n=64;
+            if(!a03_debug_hex(&s,&addr)) { printf("A03 DEBUG: invalid address\n");continue; }
+            while(*s==' ')s++;
+            if(*s && !a03_debug_hex(&s,&n)) { printf("A03 DEBUG: invalid count\n");continue; }
+            if(n==0||n>256||addr+n<addr) { printf("A03 DEBUG: count must be 1..100 hex\n");continue; }
+            unsigned char bytes[256];
+            int error=copyin((user_addr_t)addr,bytes,(size_t)n);
+            if(error) { printf("A03 DEBUG: copyin error %d\n",error);continue; }
+            for(unsigned i=0;i<n;i++) {
+                if(!(i%16))printf("%llx:",addr+i);
+                printf(" %02x",bytes[i]);
+                if(i%16==15||i+1==n)printf("\n");
+            }
+        } else printf("A03 DEBUG: help regs bt mem HEX [HEXCOUNT<=100] panic; no task resume\n");
+        printf("a03-debug> ");
+    }
+}
