+#if defined(SWEET)
+/* Same recount-backed tick source and list lock as host_statistics.
+ * No processor starts, binding, scheduler changes or reset of counters. */
+void a03_cpu_usage_probe(void);
+void
+a03_cpu_usage_probe(void)
+{
+    natural_t snapshots[MAX_CPUS][CPU_STATE_MAX] = { 0 };
+    unsigned int ids[MAX_CPUS] = { 0 };
+    unsigned int count;
+    simple_lock(&processor_list_lock, LCK_GRP_NULL);
+    count = processor_count;
+    if (count > MAX_CPUS) count = MAX_CPUS;
+    for (unsigned int i = 0; i < count; i++) {
+        processor_t processor = processor_array[i];
+        ids[i] = i;
+        if (processor != PROCESSOR_NULL) {
+            ids[i] = processor->cpu_id;
+            processor_cpu_load_info(processor, snapshots[i]);
+        }
+    }
+    simple_unlock(&processor_list_lock);
+    printf("A03 CPUS registered=%u cumulative-ticks wrap32; compare deltas\n", count);
+    for (unsigned int i = 0; i < count; i++) {
+        printf("A03 CPUS cpu=%u user=%u system=%u idle=%u nice=%u\n", ids[i],
+            snapshots[i][CPU_STATE_USER], snapshots[i][CPU_STATE_SYSTEM],
+            snapshots[i][CPU_STATE_IDLE], snapshots[i][CPU_STATE_NICE]);
+    }
+}
+#endif
