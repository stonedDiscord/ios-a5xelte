+#endif
 		if ((error = priv_check_cred(kauth_cred_get(), PRIV_WORK_INTERVAL, 0)) != 0) {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+			a03_wi_create_log(create_params.wicp_create_flags,error,KERN_NO_ACCESS);
+#endif
 			return error;
 		}
 
