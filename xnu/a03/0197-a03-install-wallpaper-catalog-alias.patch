+#if defined(ARM64_BOARD_CONFIG_SWEET)
+void a03_install_wallpaper_catalog(vnode_t root);
+
+/* Repair the existing A03 HFS root before launchd starts. */
+void
+a03_install_wallpaper_catalog(vnode_t root)
+{
+	static const char directory[] = "/Library/Wallpaper/Collections";
+	static const char source[] = "/Library/Wallpaper/Collections/Collections~iphone.plist";
+	static const char alias[] = "/Library/Wallpaper/Collections/Collections.plist";
+	static const char target[] = "Collections~iphone.plist";
+	vfs_context_t ctx = vfs_context_kernel();
+	mount_t mp = vnode_mount(root);
+	vnode_t dir = NULLVP, stock = NULLVP, resolved = NULLVP;
+	int error;
+
+	if (vfs_isrdonly(mp) || strcmp(vfs_statfs(mp)->f_fstypename, "hfs") != 0) {
+		return;
+	}
+	error = vnode_lookup(directory, VNODE_LOOKUP_NOFOLLOW, &dir, ctx);
+	if (error == 0 && (vnode_vtype(dir) != VDIR || vnode_mount(dir) != mp)) {
+		error = EINVAL;
+	}
+	if (error == 0) {
+		error = vnode_lookup(source, VNODE_LOOKUP_NOFOLLOW, &stock, ctx);
+	}
+	if (error == 0 && (vnode_vtype(stock) != VREG || vnode_mount(stock) != mp)) {
+		error = EINVAL;
+	}
+	if (error == 0) {
+		error = symlinkat_internal(ctx, CAST_USER_ADDR_T(target), AT_FDCWD,
+		    CAST_USER_ADDR_T(alias), UIO_SYSSPACE);
+		if (error == 0 || error == EEXIST) {
+			error = vnode_lookup(alias, 0, &resolved, ctx);
+			if (error == 0 && resolved != stock) {
+				error = EEXIST;
+			}
+		}
+	}
+	if (resolved != NULLVP) {
+		vnode_put(resolved);
+	}
+	if (stock != NULLVP) {
+		vnode_put(stock);
+	}
+	if (dir != NULLVP) {
+		vnode_put(dir);
+	}
+	printf("A03 wallpaper catalog: alias result=%d\n", error);
+}
+#endif
