+IOReturn IOWatchdog::setProperties(OSObject *properties) {
+ OSDictionary *dict=OSDynamicCast(OSDictionary,properties);
+ if(!dict || dict->getCount()!=1)return kIOReturnUnsupported;
+ OSNumber *stage=OSDynamicCast(OSNumber,dict->getObject("IOPMUBootStage"));
+ if(!stage || stage->unsigned64BitValue()>255)return kIOReturnBadArgument;
+ if(!setProperty("IOPMUBootStage",stage))return kIOReturnNoMemory;
+ IOLog("A03 WDT: software boot stage %llu (no PMU write)\n",stage->unsigned64BitValue());
+ return kIOReturnSuccess;
+}
