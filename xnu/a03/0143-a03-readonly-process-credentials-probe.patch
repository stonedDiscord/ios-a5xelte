+/* Read-only task credential snapshot; only the probe worker calls this. */
+static void
+a03_probe_credentials(proc_t p, const char *name, int pid)
+{
+    kauth_cred_t cred = kauth_cred_proc_ref(p);
+    if (cred == NOCRED) {
+        printf("A03 PROBE creds no credential\n");
+        return;
+    }
+    gid_t groups[NGROUPS];
+    size_t count = NGROUPS;
+    int error = kauth_cred_getgroups(cred, groups, &count);
+    printf("A03 PROBE creds %s[%d] uid %u gid %u groups err %d count %lu\n",
+        name, pid, kauth_cred_getuid(cred), kauth_cred_getgid(cred), error,
+        (unsigned long)count);
+    if (!error) {
+        if (count > NGROUPS) count = NGROUPS;
+        for (size_t i = 0; i < count; i++)
+            printf("A03 PROBE creds group %u\n", groups[i]);
+    }
+    guid_t guid;
+    error = kauth_cred_getguid(cred, &guid);
+    printf("A03 PROBE creds guid err %d\n", error);
+    if (!error) {
+        const unsigned char *g = (const unsigned char *)&guid;
+        printf("A03 PROBE creds guid %02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x\n",
+            g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7],
+            g[8], g[9], g[10], g[11], g[12], g[13], g[14], g[15]);
+    }
+    int member = -1;
+    error = kauth_cred_ismember_gid(cred, 299, &member);
+    printf("A03 PROBE creds systemusers299 err %d member %d\n", error, member);
+    kauth_cred_unref(&cred);
+}
