--- a/bsd/dev/a03_usb_console.c
+++ b/bsd/dev/a03_usb_console.c
@@ -13,6 +13,28 @@
 #include <IOKit/IOLib.h>
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern unsigned a03_console_read(unsigned char *, unsigned);
+/* Always-on syscons from the stock SM-A035G agdsp-access node.
+ * Read status only. AGCP, VBC and mailbox accesses require ownership. */
+void a03_audio_status(void);
+void
+a03_audio_status(void)
+{
+ static vm_offset_t pmu, aon;
+ if (!pmu) pmu = ml_io_map(0x64020000, 0x1000);
+ if (!aon) aon = ml_io_map(0x64000000, 0x1000);
+ if (!pmu || !aon) {
+  printf("A03 AUDIO: status mapping failed\n");
+  return;
+ }
+ uint32_t control = *(volatile uint32_t *)(pmu + 0x850);
+ uint32_t sleep = *(volatile uint32_t *)(pmu + 0x860);
+ uint32_t power = *(volatile uint32_t *)(pmu + 0x544);
+ uint32_t access = *(volatile uint32_t *)(aon + 0x14c);
+ printf("A03 AUDIO: deep=%u sleep=%u system=%u dsp=%u access=%u\n",
+     (control >> 3) & 1, (sleep >> 12) & 15, (power >> 8) & 31,
+     (power >> 16) & 31, (access >> 5) & 1);
+}
+
 void a03_usb_console_start(void);
 int a03_usb_debug_command(char *, unsigned);
