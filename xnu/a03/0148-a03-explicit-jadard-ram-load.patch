+ if(!((a==0x4000021du&&n==1)||(a==0x4000021au&&n==2)))return -1;
+ uint8_t c[]={0xf3,(uint8_t)(a>>24),(uint8_t)(a>>16),(uint8_t)(a>>8),(uint8_t)a,1};
