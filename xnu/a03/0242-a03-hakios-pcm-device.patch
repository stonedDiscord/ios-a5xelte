+ return submitted;
+}
+
+#define A03_PCM_CAPACITY 16384u
+static LCK_GRP_DECLARE(a03_pcm_group, "a03 pcm");
+LCK_SPIN_DECLARE(a03_pcm_lock, &a03_pcm_group);
+static uint32_t a03_pcm_ring[A03_PCM_CAPACITY];
+static unsigned a03_pcm_head, a03_pcm_tail;
+static bool a03_pcm_live;
+
+static int
+a03_pcm_write(__unused dev_t dev, struct uio *uio, __unused int flags)
+{
+ if (uio_resid(uio) % sizeof(uint32_t)) return EINVAL;
+ while (uio_resid(uio)) {
+  uint32_t frames[128];
+  unsigned bytes = MIN(uio_resid(uio), sizeof(frames));
+  int error = uiomove((caddr_t)frames, bytes, uio);
+  if (error) return error;
+  if (!lck_spin_try_lock(&a03_pcm_lock)) continue;
+  for (unsigned i = 0; i < bytes / sizeof(frames[0]); i++) {
+   if (a03_pcm_head - a03_pcm_tail == A03_PCM_CAPACITY) break;
+   a03_pcm_ring[a03_pcm_head++ % A03_PCM_CAPACITY] = frames[i];
+  }
+  lck_spin_unlock(&a03_pcm_lock);
+ }
+ return 0;
+}
+
+static int
+a03_pcm_open_close(__unused dev_t dev, __unused int flags,
+    __unused int type, __unused struct proc *p)
+{
+ return 0;
+}
+
+static const struct cdevsw a03_pcm_device = {
+ .d_open = a03_pcm_open_close, .d_close = a03_pcm_open_close, .d_read = eno_rdwrt,
+ .d_write = a03_pcm_write, .d_ioctl = eno_ioctl, .d_stop = eno_stop,
+ .d_reset = eno_reset, .d_select = eno_select, .d_mmap = eno_mmap,
+ .d_strategy = eno_strat
+};
+
+static bool
+a03_pcm_pending(void)
+{
+ lck_spin_lock(&a03_pcm_lock);
+ bool pending = a03_pcm_head != a03_pcm_tail;
+ lck_spin_unlock(&a03_pcm_lock);
+ return pending;
+}
+
+static unsigned
+a03_pcm_feed(vm_offset_t vbc)
+{
+ uint32_t frames[96];
+ lck_spin_lock(&a03_pcm_lock);
+ unsigned count = MIN(a03_pcm_head - a03_pcm_tail, 96u);
+ for (unsigned i = 0; i < count; i++)
+  frames[i] = a03_pcm_ring[(a03_pcm_tail + i) % A03_PCM_CAPACITY];
+ lck_spin_unlock(&a03_pcm_lock);
+ unsigned submitted = a03_audio_submit_pcm(vbc, frames, count);
+ lck_spin_lock(&a03_pcm_lock);
+ a03_pcm_tail += submitted;
+ lck_spin_unlock(&a03_pcm_lock);
  return submitted;
 }

