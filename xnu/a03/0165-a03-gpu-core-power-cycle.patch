+/* Explicit core power cycle, pinned vendor mali_kbase_pm_driver.c.
+ * No jobs/AS mappings exist; refuse inherited ready/transitioning cores.
+ * Never copy donor PMIC or core-control addresses. */
+static void
+a03_gpu_write(unsigned offset, uint32_t value)
+{
+    *(volatile uint32_t *)(a03_gpu_regs + offset) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int
+a03_gpu_wait_cores(unsigned ready, unsigned transition, uint32_t expected)
+{
+    for (unsigned i = 0; i < 2000; i++) {
+        if (a03_gpu_read(a03_gpu_regs, ready) == expected &&
+            !a03_gpu_read(a03_gpu_regs, transition)) return 1;
+        delay(10);
+    }
+    printf("A03 GPU cores: timeout ready[%x]=%08x trans[%x]=%08x expected=%x\n",
+        ready, a03_gpu_read(a03_gpu_regs, ready), transition,
+        a03_gpu_read(a03_gpu_regs, transition), expected);
+    return 0;
+}
+
+static void
+a03_gpu_core_on(unsigned offset)
+{
+    a03_gpu_write(0x50, 0x2968a819U);
+    a03_gpu_write(0x58, 0xf01e0078U);
+    a03_gpu_write(offset, 1);
+}
+
+void a03_gpu_cores(void);
+void
+a03_gpu_cores(void)
