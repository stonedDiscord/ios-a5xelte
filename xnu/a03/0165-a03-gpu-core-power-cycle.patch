+        (voltage & 0x1ffU) != 320U || !a03_gpu_pmu || !a03_gpu_aon || !a03_gpu_apb || !a03_gpu_regs) {
+        printf("A03 GPU cores: run passive gpu after validated clocks; stop\n");
+        return;
+    }
+    if (!a03_gpu_domain_accessible(a03_gpu_read(a03_gpu_pmu, 0x2c4),
+        a03_gpu_read(a03_gpu_pmu, 0x500), a03_gpu_read(a03_gpu_aon, 0)) ||
+        a03_gpu_read(a03_gpu_regs, 0) != 0x90910010U ||
+        (a03_gpu_read(a03_gpu_apb, 4) & 0x771U) != 0x11U ||
+        (a03_gpu_read(a03_gpu_apb, 8) & 0x771U) != 0x11U ||
+        (a03_gpu_read(a03_gpu_apb, 12) & 0x71U) != 0x31U) return;
+    /* Exact one-core topology and all high/ready/transition masks off. */
+    for (unsigned i = 0; i < 3; i++) {
+        if (a03_gpu_read(a03_gpu_regs, 0x100 + i * 16) != 1 ||
+            a03_gpu_read(a03_gpu_regs, 0x104 + i * 16) ||
+            a03_gpu_read(a03_gpu_regs, 0x140 + i * 16) ||
+            a03_gpu_read(a03_gpu_regs, 0x144 + i * 16) ||
+            a03_gpu_read(a03_gpu_regs, 0x200 + i * 16) ||
+            a03_gpu_read(a03_gpu_regs, 0x204 + i * 16)) {
+            printf("A03 GPU cores: inherited core ownership or topology; stop\n");
+            return;
+        }
+    }
+    uint32_t status = a03_gpu_read(a03_gpu_regs, 0x34);
+    uint32_t fault = a03_gpu_read(a03_gpu_regs, 0x3c);
+    uint32_t irq = a03_gpu_read(a03_gpu_regs, 0x20);
+    if ((status & 0xfU) || fault || (irq & 0x81U)) {
+        printf("A03 GPU cores: busy/fault status=%08x fault=%08x irq=%08x; stop\n",status,fault,irq);
+        return;
+    }
+    uint32_t override = a03_gpu_read(a03_gpu_regs, 0x58);
+    /* JM vendor path powers tiler, which powers first L2; no extra L2 request. */
+    a03_gpu_core_on(0x190);
+    int powered = a03_gpu_wait_cores(0x150, 0x210, 1) &&
+        a03_gpu_wait_cores(0x160, 0x220, 1);
+    if (powered) {
+        a03_gpu_core_on(0x180);
+        delay(120);
+        powered = a03_gpu_wait_cores(0x140, 0x200, 1);
+    }
+    printf("A03 GPU cores: on result=%d shader=%08x tiler=%08x l2=%08x pmu=%08x; no jobs\n",
+        powered, a03_gpu_read(a03_gpu_regs, 0x140), a03_gpu_read(a03_gpu_regs, 0x150),
+        a03_gpu_read(a03_gpu_regs, 0x160), a03_gpu_read(a03_gpu_pmu, 0x500));
+    /* Request shutdown even after timeout: never assume a timed-out request
+     * was cancelled. Keep override until all pending power transitions drain. */
+    a03_gpu_write(0x1c0, 1);
+    int off = a03_gpu_wait_cores(0x140, 0x200, 0);
+    if (off) {
+        a03_gpu_write(0x1d0, 1);
+        a03_gpu_write(0x1e0, 1);
+        off = a03_gpu_wait_cores(0x150, 0x210, 0) &&
+            a03_gpu_wait_cores(0x160, 0x220, 0);
+    }
+    if (off) {
+        a03_gpu_write(0x50, 0x2968a819U);
+        a03_gpu_write(0x58, override);
+    }
+    printf("A03 GPU cores: cycle powered=%d shutdown=%d irq=%08x fault=%08x; no jobs\n",
+        powered, off, a03_gpu_read(a03_gpu_regs, 0x20), a03_gpu_read(a03_gpu_regs, 0x3c));
+}
 #endif
