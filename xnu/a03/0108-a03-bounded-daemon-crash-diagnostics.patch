+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Read-only crash evidence before corpse limits discard the report. The caller
+ * selects processes, gates the boot argument and permits two reports per name.
+ * Saved user state belongs to the exiting thread; no task mutation or resume.
+ */
+void a03_daemon_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode);
+
+void
+a03_daemon_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode)
+{
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	arm_saved_state_t *ss = find_user_regs(thread);
+	uint64_t slide = 0, mh = task->mach_header_vm_address;
+
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("CRASH %s[%d] sig %d code 0x%llx sub 0x%llx slide 0x%llx mh 0x%llx\n",
+	    name, pid, sig, code, subcode, slide, mh);
+	if (ss == NULL || !is_saved_state64(ss)) {
+		return;
+	}
+	uint64_t x19 = saved_state64(ss)->x[19];
+	char message[160];
+	vm_size_t copied = 0;
+	if (x19 != 0 && copyinstr((user_addr_t)x19, message, sizeof(message), &copied) == 0) {
+		bool printable = copied > 1;
+		for (vm_size_t i = 0; i + 1 < copied; i++) {
+			if ((unsigned char)message[i] < 32 || (unsigned char)message[i] > 126) printable = false;
+		}
+		if (printable) printf("CRASH %s x19: %s\n", name, message);
+	}
+	uint64_t fp = get_saved_state_fp(ss);
+	printf("CRASH %s pc 0x%llx lr 0x%llx sp 0x%llx fp 0x%llx far 0x%llx\n", name,
+	    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss), fp,
+	    (uint64_t)saved_state64(ss)->far);
+
+	char line[200];
+	int n = snprintf(line, sizeof(line), "CRASH %s bt", name);
+	for (int i = 0; i < 6 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+		uint64_t frame[2];
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("%s\n", line);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
