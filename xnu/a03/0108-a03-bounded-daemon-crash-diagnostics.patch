+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Bounded USB/screen diagnostics independent of corpse/ReportCrash availability. */
+static bool
+a03_should_log_daemon_crash(const char *name, int sig)
+{
+    uint32_t enabled = 0;
+    PE_parse_boot_argn("a03crash_log", &enabled, sizeof(enabled));
+    if (enabled != 1 || (sig != SIGABRT && sig != SIGTRAP && sig != SIGSEGV &&
+        sig != SIGBUS && sig != SIGILL && sig != SIGKILL)) {
+        return false;
+    }
+    static _Atomic uint32_t counts[11];
+    unsigned slot;
+    if (!strcmp(name, "watchdogd")) slot = 0;
+    else if (!strcmp(name, "backboardd")) slot = 1;
+    else if (!strcmp(name, "SpringBoard")) slot = 2;
+    else if (!strcmp(name, "launchd")) slot = 3;
+    else if (!strcmp(name, "xpcproxy")) slot = 4;
+    else if (!strcmp(name, "bluetoothd")) slot = 5;
+    else if (!strcmp(name, "identityservices")) slot = 6;
+    else if (!strcmp(name, "fairplayd.H2") || !strcmp(name, "fairplayd")) slot = 7;
+    else if (!strcmp(name, "mediaserverd")) slot = 8;
+    else if (!strcmp(name, "configd")) slot = 9;
+    else if (!strcmp(name, "lockdownd")) slot = 10;
+    else return false;
+    /* Saturate: never wrap and resume flooding after a long crash loop. */
+    uint32_t count = atomic_load_explicit(&counts[slot], memory_order_relaxed);
+    while (count < 2) {
+        if (atomic_compare_exchange_weak_explicit(&counts[slot], &count, count + 1,
+            memory_order_relaxed, memory_order_relaxed)) return true;
+    }
+    return false;
+}
+#endif
