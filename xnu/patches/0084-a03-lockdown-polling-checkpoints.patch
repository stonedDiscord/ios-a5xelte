+/* A03 diagnostic profile only: polling output without kprintf/os_log locks. */
+static void
+a03_startup_checkpoint(const char *message)
+{
+	uint64_t daif = __builtin_arm_rsr64("DAIF");
+	__builtin_arm_wsr("DAIFSet", 3);
+	const char *prefix = "";
+	while (*prefix) {
+		serial_putc(*prefix++);
+	}
+	while (*message) {
+		serial_putc(*message++);
+	}
+	serial_putc(13);
+	serial_putc(10);
+	#if SCHED_HYGIENE_DEBUG
+	if ((daif & 0xc0) == 0) {
+		ml_spin_debug_clear_self();
+	}
+#endif
+	__builtin_arm_wsr64("DAIF", daif);
+}
+
+static void
+a03_startup_address(const char *label, uintptr_t value)
+{
+	/* No stack buffer: automatic initialization may emit forbidden SIMD. */
+	uint64_t daif = __builtin_arm_rsr64("DAIF");
+	__builtin_arm_wsr("DAIFSet", 3);
+	const char *prefix = "";
+	while (*prefix) {
+		serial_putc(*prefix++);
+	}
+	while (*label) {
+		serial_putc(*label++);
+	}
+	serial_putc(' ');
+	for (unsigned int i = 0; i < 16; i++) {
+		serial_putc("0123456789abcdef"[(value >> ((15 - i) * 4)) & 15]);
+	}
+	serial_putc(13);
+	serial_putc(10);
+#if SCHED_HYGIENE_DEBUG
+	if ((daif & 0xc0) == 0) {
+		ml_spin_debug_clear_self();
+	}
+#endif
+	__builtin_arm_wsr64("DAIF", daif);
+}
+
+#else
+#define a03_startup_checkpoint(message) ((void)0)
+#endif
