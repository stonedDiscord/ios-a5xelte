+#if defined(SWEET)
+/* A03 diagnostic profile only: polling output without kprintf/os_log locks. */
+static void
+a03_startup_checkpoint(const char *message)
+{
+	boolean_t enabled = ml_set_interrupts_enabled(FALSE);
+	const char *prefix = "A03 STEP ";
+	while (*prefix) {
+		serial_putc(*prefix++);
+	}
+	while (*message) {
+		serial_putc(*message++);
+	}
+	serial_putc(13);
+	serial_putc(10);
+	ml_set_interrupts_enabled(enabled);
+}
+#else
+#define a03_startup_checkpoint(message) ((void)0)
+#endif
+
 static inline void
 kernel_bootstrap_log(const char *message)
 {
+#if defined(SWEET)
+	if (startup_phase == STARTUP_SUB_LOCKDOWN) {
+		a03_startup_checkpoint(message);
+		return;
+	}
+#endif
 	if ((startup_debug & STARTUP_DEBUG_VERBOSE) &&
 	    startup_phase >= STARTUP_SUB_KPRINTF) {
 		kprintf("kernel_bootstrap: %s\n", message);
