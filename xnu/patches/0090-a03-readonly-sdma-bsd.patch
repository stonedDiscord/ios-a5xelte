+static int emmc_write(dev_t dev,struct uio *uio,__unused int flags) {
+    if(!ae.ready||ae.poisoned||minor(dev)>1)return ENXIO;
+    if(!ae.writable||minor(dev)!=1)return EROFS;
+    if(uio_offset(uio)<0||uio_resid(uio)<0)return EINVAL;
+    uint64_t size=(uint64_t)part_count(dev)*512,pos=(uint64_t)uio_offset(uio);
