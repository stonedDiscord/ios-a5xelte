+static int emmc_ioctl(dev_t dev,u_long cmd,caddr_t data,__unused int flag,__unused struct proc *p) {
+    if(!ae.ready||ae.poisoned||minor(dev)>1)return ENXIO;
+    switch(cmd) {
+    case DKIOCGETBLOCKSIZE:case DKIOCGETPHYSICALBLOCKSIZE:*(uint32_t *)data=512;return 0;
+    case DKIOCSETBLOCKSIZE:return *(uint32_t *)data==512?0:EINVAL;
+    case DKIOCGETBLOCKCOUNT:*(uint64_t *)data=part_count(dev);return 0;
+    case DKIOCISWRITABLE:*(uint32_t *)data=ae.writable&&minor(dev)==1;return 0;
+    case DKIOCGETMAXBLOCKCOUNTREAD:*(uint64_t *)data=128;return 0;
+    case DKIOCGETMAXBLOCKCOUNTWRITE:*(uint64_t *)data=ae.writable&&minor(dev)==1?128:0;return 0;
