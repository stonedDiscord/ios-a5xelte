+static int emmc_close(__unused dev_t dev,__unused int flags,__unused int type,__unused struct proc *p) {return 0;}
+static void emmc_strategy(buf_t bp) {
+    int error=0;caddr_t addr=NULL;uint32_t count=buf_count(bp),done=0;
+    dev_t dev=buf_device(bp);uint64_t offset=0;
+    buf_setresid(bp,count);
