--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -85,6 +85,42 @@
  * clock/isolation/reset path; never apply Qualcomm clock/PHY registers.
  */
 static vm_offset_t dreamlte_phy;
+/* Samsung CAL exynos_cal_usbphy_q_ch(enable=1), before DCTL reset.
+ * Only the measured primary PIPE-clock selection is supported here. Do not
+ * change the port mux, PLL/reference tuning, power domains or clock rates.
+ */
+static int
+dreamlte_usb_link_wake(vm_offset_t phy)
+{
+	uint32_t sel = usb_rd(phy, 0x6c);
+	if (sel & (1u << 3)) {
+		printf("DREAMLTE USB: secondary PHY clock selected; wake refused\n");
+		return -1;
+	}
+	uint32_t link = usb_rd(phy, 0x04);
+	if (link & (1u << 28)) return -1;
+	uint32_t q = usb_rd(phy, 0x34);
+	uint32_t wake = (q | (0xfu << 10)) & ~(1u << 9);
+	delay(500);
+	*(volatile uint32_t *)(phy + 0x34) = wake;
+	__asm__ volatile("dsb sy" ::: "memory");
+	delay(500);
+	wake = usb_rd(phy, 0x34) | (1u << 9);
+	delay(500);
+	*(volatile uint32_t *)(phy + 0x34) = wake;
+	__asm__ volatile("dsb sy" ::: "memory");
+	link = usb_rd(phy, 0x04);
+	*(volatile uint32_t *)(phy + 0x04) = link | (1u << 28);
+	__asm__ volatile("dsb sy" ::: "memory");
+	delay(10);
+	*(volatile uint32_t *)(phy + 0x04) = link & ~(1u << 28);
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("DREAMLTE USB: link wake Q=%08x LINK=%08x SEL=%08x\n",
+	    usb_rd(phy, 0x34), usb_rd(phy, 0x04), sel);
+	if (!(usb_rd(phy, 0x34) & (1u << 9))) return -1;
+	return 0;
+}
+
 static int
 dreamlte_usb_prepare(vm_offset_t dwc)
 {
@@ -109,6 +145,7 @@
 	 * SUSPHY. Preserve PHYIF, turnaround and board tuning fields.
 	 */
 	*(volatile uint32_t *)(dwc + 0xc200) = usb2 & ~((1u << 8) | (1u << 6));
+	if (dreamlte_usb_link_wake(phy)) return -1;
 	dreamlte_phy = phy;
 	/* Select device mode while stopped. */
 	uint32_t gctl = usb_rd(dwc, 0xc110);
