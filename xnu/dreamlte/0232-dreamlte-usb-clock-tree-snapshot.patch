--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -85,6 +85,32 @@
  * clock/isolation/reset path; never apply Qualcomm clock/PHY registers.
  */
 static vm_offset_t dreamlte_phy;
+/* Pinned Exynos8895 cmucal-sfr.c: read USB clock state only. These
+ * always-on CMU configuration windows are distinct from the PHY bank.
+ * Never change mux/divider/gates/Q-channel based on an inferred clock.
+ */
+static vm_offset_t dreamlte_fsys_cmu, dreamlte_top_cmu;
+struct dreamlte_usb_clocks { uint32_t busmux, usbmux, aclk, ref, suspend, qch, mux, div, gate; };
+static void
+dreamlte_usb_clocks_capture(struct dreamlte_usb_clocks *v)
+{
+	v->busmux = usb_rd(dreamlte_fsys_cmu, 0x100);
+	v->usbmux = usb_rd(dreamlte_fsys_cmu, 0x180);
+	v->aclk = usb_rd(dreamlte_fsys_cmu, 0x2078);
+	v->ref = usb_rd(dreamlte_fsys_cmu, 0x207c);
+	v->suspend = usb_rd(dreamlte_fsys_cmu, 0x2080);
+	v->qch = usb_rd(dreamlte_fsys_cmu, 0x3044);
+	v->mux = usb_rd(dreamlte_top_cmu, 0x1068);
+	v->div = usb_rd(dreamlte_top_cmu, 0x1864);
+	v->gate = usb_rd(dreamlte_top_cmu, 0x206c);
+}
+static void
+dreamlte_usb_clocks_print(const char *stage, const struct dreamlte_usb_clocks *v)
+{
+	printf("DREAMLTE CMU %s: BUSMUX=%08x USBMUX=%08x QCH=%08x\n", stage, v->busmux, v->usbmux, v->qch);
+	printf("DREAMLTE CMU %s: ACLK=%08x REF=%08x SUSP=%08x\n", stage, v->aclk, v->ref, v->suspend);
+	printf("DREAMLTE CMU %s: TOPMUX=%08x DIV=%08x GATE=%08x\n", stage, v->mux, v->div, v->gate);
+}
 /* Samsung CAL exynos_cal_usbphy_q_ch(enable=1), before DCTL reset.
  * Only the measured primary PIPE-clock selection is supported here. Do not
  * change the port mux, PLL/reference tuning, power domains or clock rates.
@@ -312,6 +338,9 @@
 		printf("DREAMLTE USB: firmware controller running/resetting; refusing takeover\n");
 		return;
 	}
+	dreamlte_fsys_cmu = ml_io_map(0x11000000, 0x4000);
+	dreamlte_top_cmu = ml_io_map(0x15a80000, 0x3000);
+	if (!dreamlte_fsys_cmu || !dreamlte_top_cmu) return;
 	if (!dreamlte_usb_prepare(dwc)) sweet_usb_gadget_start(dwc);
 }
 #else
@@ -562,7 +591,10 @@
 	int resource_woke = 0;
 	uint32_t resource_first = 0, resource_last = 0, resource_exit = 0;
 	unsigned resource_samples = 0;
+	struct dreamlte_usb_clocks resource_clocks;
 	if (resource_clock) {
+		dreamlte_usb_clocks_capture(&resource_clocks);
+		dreamlte_usb_clocks_print("entry", &resource_clocks);
 		printf("DREAMLTE USB: resource-entry CLK=%08x\n",
 		    usb_rd(dreamlte_phy, 0x10));
 	}
@@ -608,7 +640,10 @@
 	/* Capture before timeout/framebuffer output. The later failure dump
 	 * previously read CLK only after multiple slow console writes.
 	 */
-	if (resource_clock) resource_exit = usb_rd(dreamlte_phy, 0x10);
+	if (resource_clock) {
+		resource_exit = usb_rd(dreamlte_phy, 0x10);
+		dreamlte_usb_clocks_capture(&resource_clocks);
+	}
 #endif
 	printf("SWEET USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
 #if defined(DREAMLTE)
@@ -617,6 +652,7 @@
 		printf("DREAMLTE USB POLL: first=%08x last=%08x exit=%08x n=%u wake=%u\n",
 		    resource_first, resource_last, resource_exit,
 		    resource_samples, (unsigned)resource_woke);
+		dreamlte_usb_clocks_print("prelog-exit", &resource_clocks);
 	}
 #endif
 	return -1;
