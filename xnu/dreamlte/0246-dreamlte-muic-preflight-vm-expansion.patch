+/* MUIC access preflight only. Pinned Samsung3cfb914 and live DT:
+ * 10970000 uses rate_hsi2c=0x121 (PERIC1_BUS user mux) and
+ * gate_hsi2c=0x110 (USI13), NOT BUSC HSI2CDF. Do not send I2C traffic,
+ * change clocks/pins, or read TRANS_STATUS (its DONE bit clears on read).
+ * Require stable, explicitly enabled manual gates before touching either
+ * peripheral bank. A refusal is useful evidence, not a route measurement.
+ */
+static vm_offset_t dreamlte_muic_cmu, dreamlte_muic_gpio, dreamlte_muic_i2c;
+static bool
+dreamlte_muic_gate_ready(uint32_t gate)
+{
+	return gate != 0xffffffffu &&
+	    (gate & ((1u << 21) | (1u << 20))) == ((1u << 21) | (1u << 20)) &&
+	    !(gate & (1u << 28));
+}
+static void
+dreamlte_muic_preflight(const char *stage)
+{
+	if (!dreamlte_muic_cmu) return;
+	uint32_t bus = usb_rd(dreamlte_muic_cmu, 0x100);
+	uint32_t pclk = usb_rd(dreamlte_muic_cmu, 0x20cc);
+	uint32_t sclk = usb_rd(dreamlte_muic_cmu, 0x20d0);
+	uint32_t gpio = usb_rd(dreamlte_muic_cmu, 0x2028);
+	uint32_t qch = usb_rd(dreamlte_muic_cmu, 0x3068);
+	uint32_t sync = usb_rd(dreamlte_muic_cmu, 0x2044);
+	printf("DREAMLTE MUIC %s: BUS=%08x PCLK=%08x SCLK=%08x GPIO=%08x QCH=%08x SYNC=%08x\n",
+	    stage, bus, pclk, sclk, gpio, qch, sync);
+	if (bus == 0xffffffffu || (bus & (1u << 7)) ||
+	    !dreamlte_muic_gate_ready(sync)) {
+		printf("DREAMLTE MUIC: bus not held stable/on; peripheral banks not read\n");
+		return;
+	}
+	if (dreamlte_muic_gate_ready(gpio) && dreamlte_muic_gpio) {
+		/* Pinned pinctrl-exynos: PERIC1 GPE5 bank0xc0; FUNC0, DAT4,
+		 * PUD8. SDA/SCL pins6/7 expect function2, as live hsi2c32-bus. */
+		printf("DREAMLTE MUIC %s: GPE5 CON=%08x DAT=%08x PUD=%08x\n", stage,
+		    usb_rd(dreamlte_muic_gpio, 0xc0),
+		    usb_rd(dreamlte_muic_gpio, 0xc4),
+		    usb_rd(dreamlte_muic_gpio, 0xc8));
+	} else {
+		printf("DREAMLTE MUIC: GPIO gate not held on; pins not read\n");
+	}
+	if (dreamlte_muic_gate_ready(pclk) && dreamlte_muic_i2c) {
+		/* Register configuration only; no FIFO data, IRQ or transfer
+		 * status read, and no writes even if firmware state is unusable. */
+		printf("DREAMLTE MUIC %s: CTL=%08x CONF=%08x AUTO=%08x ADDR=%08x\n", stage,
+		    usb_rd(dreamlte_muic_i2c, 0x00), usb_rd(dreamlte_muic_i2c, 0x40),
+		    usb_rd(dreamlte_muic_i2c, 0x44), usb_rd(dreamlte_muic_i2c, 0x70));
+		printf("DREAMLTE MUIC %s: FS1=%08x FS2=%08x FS3=%08x SLA=%08x\n", stage,
+		    usb_rd(dreamlte_muic_i2c, 0x60), usb_rd(dreamlte_muic_i2c, 0x64),
+		    usb_rd(dreamlte_muic_i2c, 0x68), usb_rd(dreamlte_muic_i2c, 0x6c));
+	} else {
+		printf("DREAMLTE MUIC: I2C gate not held on; controller not read\n");
+	}
+}
