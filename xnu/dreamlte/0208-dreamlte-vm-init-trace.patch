diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1947,6 +1947,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	if (dynamic_memory_begin > VM_MAX_KERNEL_ADDRESS) {
 		panic("Unsupported memory configuration %lx", mem_size);
 	}
+	sweet_early_mark(8, "VM memory window computed");
 
 	boot_tte = (tt_entry_t *)&bootstrap_pagetables;
 	boot_ttep = kvtophys((vm_offset_t)boot_tte);
@@ -2018,6 +2019,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	init_ptpages(cpu_tte, physmap_base, ROUND_L1(physmap_end), TRUE, ARM_DYNAMIC_TABLE_XN | ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
 #endif
 
+	sweet_early_mark(8, "bootstrap page tables initialized");
 
 #if __ARM_KERNEL_PROTECT__
 	/* Expand the page tables to prepare for the EL0 mappings. */
@@ -2182,7 +2184,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	/* phystokv() must still refer to the bootstrap aperture here. */
 	sweet_early_map_final();
 #endif
+	sweet_early_mark(9, "calling arm_vm_physmap_init");
 	arm_vm_physmap_init(args);
+	sweet_early_mark(9, "physmap ready; switching TTBR0");
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 	ml_enable_monitor();
@@ -2191,6 +2196,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
 	sweet_early_relocate(SWEET_EARLY_FB_VA);
 #endif
+	sweet_early_disable();
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -90,5 +90,9 @@ sweet_early_mark(unsigned int stage, const char *label)
 {
-	if (!a5_active || stage > 7) {
+#if defined(DREAMLTE)
+	if (!a5_active || stage > 9) {
+#else
+	if (!a5_active || stage > 7) {
+#endif
 		return;
 	}
 	a5_string("A5 XNU STAGE ");
@@ -97,8 +101,10 @@ sweet_early_mark(unsigned int stage, const char *label)
 	a5_string(label);
 	sweet_early_putc('\n');
 	__asm__ volatile("dsb sy" ::: "memory");
-	/* arm_vm_init replaces TTBR0; low physical aliases then cease to exist. */
+#if !defined(DREAMLTE)
+	/* arm_vm_init replaces TTBR0; low physical aliases then cease to exist. */
 	if (stage == 7) {
 		a5_active = 0;
 	}
+#endif
 }
