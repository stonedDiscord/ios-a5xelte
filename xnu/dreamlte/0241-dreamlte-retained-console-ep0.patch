 #if defined(DREAMLTE)
+/* Read only the reserved append-only boot console, never arbitrary RAM.
+ * Independent offsets leave the UDP reader untouched. The host snapshots
+ * length once so later console output cannot extend a download forever. */
+extern uint32_t dreamlte_console_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t dreamlte_console_position(void);
+static int
+dreamlte_usb_console_read(uint8_t req, uint16_t value, uint16_t index,
+    uint16_t length, uint8_t *data)
+{
+	if (req == 0x52) {
+		if (value != 0 || index != 0x8895 || length != 8) return -1;
+		uint64_t end = dreamlte_console_position();
+		if (end > 0x200000u) return -1;
+		memcpy(data, "DLOG", 4);
+		for (unsigned i = 0; i < 4; i++) data[4 + i] = (uint8_t)(end >> (8 * i));
+		return 8;
+	}
+	uint64_t pos = ((uint32_t)index << 16) | value;
+	if (req != 0x53 || length == 0 || length > 512 || pos > 0x200000u) return -1;
+	return (int)dreamlte_console_copy(&pos, (char *)data, length);
+}
