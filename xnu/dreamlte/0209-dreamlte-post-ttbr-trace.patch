diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2199,1 +2199,3 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
-	sweet_early_disable();
+#if !defined(DREAMLTE)
+	sweet_early_disable();
+#endif
@@ -2202,4 +2204,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	flush_mmu_tlb();
+#if defined(DREAMLTE)
+	sweet_early_relocate(phystokv(A5XELTE_FB_PA));
+#endif
 	sweet_early_mark(10, "TTBR0 off; TLB flushed");
 	kva_active = TRUE;
 	// global table pointers may need to be different due to physical aperture remapping
@@ -2301,5 +2306,6 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 	sweet_early_mark(12, "calling pmap_bootstrap");
 	pmap_bootstrap(dynamic_memory_begin);
 	sweet_early_mark(13, "pmap_bootstrap done");
+	sweet_early_disable();
 
 	disable_preemption();
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -14,3 +14,13 @@
-/* The bootstrap TTBR0 maps DECON scanout VA=PA until arm_vm_init. */
-#define A5_FB ((volatile uint32_t *)(uintptr_t)A5XELTE_FB_PA)
+/* DREAMLTE keeps a bounded RAM trace through early page-table setup. */
+#if defined(DREAMLTE)
+#define DREAMLTE_LOG_CURSOR_PA 0x91200200u
+#define DREAMLTE_LOG_BASE_PA   0x91a00000u
+#define DREAMLTE_LOG_END_PA    0x91c00000u
+static volatile uint32_t *dreamlte_log_cursor = (volatile uint32_t *)(uintptr_t)DREAMLTE_LOG_CURSOR_PA;
+static volatile uint8_t *dreamlte_log_base = (volatile uint8_t *)(uintptr_t)DREAMLTE_LOG_BASE_PA;
+#endif
+static volatile uint32_t *a5_fb = (volatile uint32_t *)(uintptr_t)A5XELTE_FB_PA;
+
+/* The bootstrap TTBR0 maps the board's early output area VA=PA. */
+#define A5_FB a5_fb
 #define A5_STRIDE (A5XELTE_FB_STRIDE / 4u)
@@ -74,10 +84,10 @@ a5_string(const char *s)
 #if defined(DREAMLTE)
-		uint32_t p = *(volatile uint32_t *)(uintptr_t)0x91200200u;
-		if (p >= 0x91a00000u && p < 0x91c00000u) {
-			*(volatile uint8_t *)(uintptr_t)p = (uint8_t)*s;
-			*(volatile uint32_t *)(uintptr_t)0x91200200u = p + 1;
-			__asm__ volatile("dc cvac, %0" :: "r"((uintptr_t)p) : "memory");
-			__asm__ volatile("dc cvac, %0" :: "r"((uintptr_t)0x91200200u) : "memory");
+		uint32_t p = *dreamlte_log_cursor;
+		if (p >= DREAMLTE_LOG_BASE_PA && p < DREAMLTE_LOG_END_PA) {
+			dreamlte_log_base[p - DREAMLTE_LOG_BASE_PA] = (uint8_t)*s;
+			*dreamlte_log_cursor = p + 1;
+			__asm__ volatile("dc cvac, %0" :: "r"((uintptr_t)&dreamlte_log_base[p - DREAMLTE_LOG_BASE_PA]) : "memory");
+			__asm__ volatile("dc cvac, %0" :: "r"((uintptr_t)dreamlte_log_cursor) : "memory");
 			__asm__ volatile("dsb sy" ::: "memory");
 		}
 #endif
@@ -91,3 +101,3 @@ sweet_early_mark(unsigned int stage, const char *label)
 #if defined(DREAMLTE)
-	if (!a5_active || stage > 9) {
+	if (!a5_active || stage > 13) {
 #else
@@ -98,3 +108,6 @@ sweet_early_mark(unsigned int stage, const char *label)
 	a5_string("A5 XNU STAGE ");
-	sweet_early_putc((char)('0' + stage));
+	if (stage >= 10) {
+		sweet_early_putc((char)('0' + stage / 10));
+	}
+	sweet_early_putc((char)('0' + stage % 10));
 	a5_string(": ");
@@ -128,1 +141,11 @@
-void sweet_early_relocate(uint64_t base) { (void)base; }
+void
+sweet_early_relocate(uint64_t base)
+{
+#if defined(DREAMLTE)
+	a5_fb = (volatile uint32_t *)(uintptr_t)base;
+	dreamlte_log_cursor = (volatile uint32_t *)(uintptr_t)phystokv(DREAMLTE_LOG_CURSOR_PA);
+	dreamlte_log_base = (volatile uint8_t *)(uintptr_t)phystokv(DREAMLTE_LOG_BASE_PA);
+#else
+	(void)base;
+#endif
+}
