 	sweet_early_disable();
+#endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
+#if defined(DREAMLTE)
+	sweet_early_relocate(phystokv(A5XELTE_FB_PA));
+#endif
