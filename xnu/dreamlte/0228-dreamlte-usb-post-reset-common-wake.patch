+/* Samsung CAL disables link-driven common-block suspend in ss_enable.
+ * The0227 failure snapshot shows EN_UTMISUSPEND reasserted later. Reapply
+ * only that wake bit after DCTL reset; preserve PLL/reference/reset fields.
+ */
+static int
+dreamlte_usb_post_reset_wake(vm_offset_t phy)
+{
+	uint32_t before = usb_rd(phy, 0x10);
+	uint32_t pipe = usb_rd(phy, 0x0c);
+	uint32_t sel = usb_rd(phy, 0x6c);
+	if (before == 0xffffffffu || (before & 2u) ||
+	    (sel & 0x3fu) || !(pipe & (1u << 4)) || pipe == 0xffffffffu) {
+		printf("DREAMLTE USB: post-reset wake refused CLK=%08x PIPE=%08x SEL=%08x\n",
+		    before, pipe, sel);
+		return -1;
+	}
+	uint32_t awake = before & ~(1u << 31);
+	if (awake != before) {
+		*(volatile uint32_t *)(phy + 0x10) = awake;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	delay(500);
+	uint32_t after = usb_rd(phy, 0x10);
+	printf("DREAMLTE USB: post-reset wake CLK=%08x->%08x PIPE=%08x\n",
+	    before, after, pipe);
+	if (after != awake) return -1;
+	return 0;
+}
