  * revisions >=2.50a. Firmware PIPE010c0002 lacks it; saved Android PIPE
  * is110c0002. Apply only this bit on the measured stopped2.80a core.
  */
+/* Samsung pinned 3cfb914 gadget_pullup/reset/conndone and CAL
+ * enable/disable_dp_pullup: only PHYUTMI.VBUSVLDEXT bit9 changes.
+ * The board has is_not_vbus_pad. This controls the PHY signal, never
+ * the cable's VBUS supply. Keep LINK force-valid and every other field.
+ */
+static int
+dreamlte_usb_dp_pullup(bool enable)
+{
+	if (!dreamlte_phy) return -1;
+	uint32_t before = usb_rd(dreamlte_phy, 0x08);
+	if (before == 0xffffffffu) return -1;
+	uint32_t desired = enable ? before | (1u << 9) : before & ~(1u << 9);
+	if (desired != before) {
+		*(volatile uint32_t *)(dreamlte_phy + 0x08) = desired;
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+	uint32_t after = usb_rd(dreamlte_phy, 0x08);
+	printf("DREAMLTE USB: DP pullup %u UTMI=%08x->%08x\n", enable, before, after);
+	return after == desired ? 0 : -1;
+}
