@@ -408,6 +408,34 @@
 	return -1;
 }
 
+#if defined(DREAMLTE)
+/* Samsung gadget.c start_config assigns resources to all implemented
+ * endpoints immediately after DEPSTARTCFG, before any SETEPCONFIG.
+ * GHWPARAMS3 counts/layout follow pinned core.h and init_hw_endpoints.
+ */
+static int
+dreamlte_usb_resources(void)
+{
+	uint32_t hw = dwc_rd(0xc14c);
+	unsigned total = (hw >> 12) & 0x3f;
+	unsigned in = (hw >> 18) & 0x1f;
+	unsigned out = total >= in ? total - in : 0;
+	if (in < 3 || out < 2 || in > 16 || out > 16) {
+		printf("DREAMLTE USB: invalid endpoint counts hw=%08x in=%u out=%u\n", hw, in, out);
+		return -1;
+	}
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0)) return -1;
+	for (unsigned n = 0; n < out; n++) {
+		if (ud_epcmd(2 * n, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) return -1;
+	}
+	for (unsigned n = 0; n < in; n++) {
+		if (ud_epcmd(2 * n + 1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) return -1;
+	}
+	printf("DREAMLTE USB: resources assigned in=%u out=%u\n", in, out);
+	return 0;
+}
+#endif
+
 /* One TRB (at DMA offset trb) on physical endpoint ep. */
 static void
 ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
