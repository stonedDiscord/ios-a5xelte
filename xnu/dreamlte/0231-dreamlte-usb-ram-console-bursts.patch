--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -18,6 +18,36 @@
 #define DREAMLTE_LOG_END_PA    0x91c00000u
 static volatile uint32_t *dreamlte_log_cursor = (volatile uint32_t *)(uintptr_t)DREAMLTE_LOG_CURSOR_PA;
 static volatile uint8_t *dreamlte_log_base = (volatile uint8_t *)(uintptr_t)DREAMLTE_LOG_BASE_PA;
+
+/* Copy the append-only S8 RAM trace without allocation, disk I/O or printf.
+ * A full trace saturates; it never wraps into memory outside this buffer.
+ * Only the USB log thread owns its read cursor.
+ */
+uint64_t dreamlte_console_position(void);
+uint32_t dreamlte_console_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint64_t
+dreamlte_console_position(void)
+{
+	uint32_t end = *dreamlte_log_cursor;
+	if (end < DREAMLTE_LOG_BASE_PA || end > DREAMLTE_LOG_END_PA) return 0;
+	__asm__ volatile("dmb ishld" ::: "memory");
+	return end - DREAMLTE_LOG_BASE_PA;
+}
+
+uint32_t
+dreamlte_console_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t end = dreamlte_console_position();
+	if (*pos >= end) return 0;
+	uint64_t count = end - *pos;
+	if (count > max) count = max;
+	for (uint32_t n = 0; n < (uint32_t)count; n++) {
+		out[n] = (char)dreamlte_log_base[*pos + n];
+	}
+	*pos += count;
+	return (uint32_t)count;
+}
