+#if defined(DREAMLTE)
+/* Diagnostic output budget only: do not change host/Mach IPC decisions.
+ * Eight normal reports per site; an independent16-report failure budget. */
+boolean_t dreamlte_host_log_allowed(unsigned site, boolean_t failed);
+boolean_t
+dreamlte_host_log_allowed(unsigned site, boolean_t failed)
+{
+    static unsigned reports[5];
+    if (site >= 4) return FALSE;
+    unsigned slot = failed ? 4 : site;
+    unsigned limit = failed ? 16 : 8;
+    unsigned old = __atomic_load_n(&reports[slot], __ATOMIC_RELAXED);
+    do {
+        if (old >= limit) return FALSE;
+    } while (!__atomic_compare_exchange_n(&reports[slot], &old, old + 1,
+        false, __ATOMIC_RELAXED, __ATOMIC_RELAXED));
+    return TRUE;
+}
+#endif
