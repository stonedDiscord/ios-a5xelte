+/* Read current-task Mach-O annotations, never a fixed shared-cache address.
+ * Layout prefixes follow kdp/kdp_dyld.h and the version-5 crash annotations
+ * in this root's libc++abi. Existing caller gate/two-report cap still apply. */
+static int
+dreamlte_crash_read(uint64_t address, void *out, size_t size)
+{
+    if (address == 0 || address + size < address) return 1;
+    return copyin((user_addr_t)address, out, size);
+}
+
+static void
+dreamlte_crash_message(const char *name, unsigned slot, uint64_t address)
+{
+    char text[256];
+    unsigned n;
+    if (address == 0) return;
+    for (n = 0; n < sizeof(text) - 1; n++) {
+        unsigned char c;
+        if (address + n < address || dreamlte_crash_read(address + n, &c, 1)) return;
+        if (c == 0) break;
+        text[n] = c >= 32 && c <= 126 ? (char)c : ' ';
+    }
+    text[n] = 0;
+    if (n) printf("CRASH %s annotation%u: %s%s\n", name, slot, text,
+        n == sizeof(text) - 1 ? " [bounded]" : "");
+}
+
+static void
+dreamlte_crash_image(const char *name, uint64_t base)
+{
+    struct mach_header_64 mh;
+    if (dreamlte_crash_read(base, &mh, sizeof(mh)) || mh.magic != MH_MAGIC_64 ||
+        mh.cputype != CPU_TYPE_ARM64 || mh.ncmds > 128 ||
+        mh.sizeofcmds > 65536 || mh.sizeofcmds < mh.ncmds * sizeof(struct load_command) ||
+        base + sizeof(mh) + mh.sizeofcmds < base) return;
+    uint64_t commands = base + sizeof(mh), text_vmaddr = 0, annotation = 0;
+    bool have_text = false;
+    unsigned offset = 0;
+    for (unsigned i = 0; i < mh.ncmds; i++) {
+        struct load_command lc;
+        if (offset > mh.sizeofcmds || mh.sizeofcmds - offset < sizeof(lc) ||
+            dreamlte_crash_read(commands + offset, &lc, sizeof(lc)) ||
+            lc.cmdsize < sizeof(lc) || (lc.cmdsize & 7) ||
+            lc.cmdsize > mh.sizeofcmds - offset) return;
+        if (lc.cmd == LC_SEGMENT_64) {
+            struct segment_command_64 seg;
+            if (lc.cmdsize < sizeof(seg) ||
+                dreamlte_crash_read(commands + offset, &seg, sizeof(seg)) ||
+                seg.nsects > 128 || seg.nsects > (lc.cmdsize - sizeof(seg)) / sizeof(struct section_64) ||
+                seg.vmaddr + seg.vmsize < seg.vmaddr) return;
+            if (!strncmp(seg.segname, "__TEXT", 16) &&
+                seg.filesize >= sizeof(mh) + mh.sizeofcmds) {
+                text_vmaddr = seg.vmaddr;
+                have_text = true;
+            }
+            for (unsigned j = 0; j < seg.nsects; j++) {
+                struct section_64 section;
+                if (dreamlte_crash_read(commands + offset + sizeof(seg) +
+                    j * sizeof(section), &section, sizeof(section))) return;
+                if (!strncmp(section.sectname, "__crash_info", 16) &&
+                    !strncmp(section.segname, seg.segname, 16) && section.size >= 64 &&
+                    section.addr >= seg.vmaddr && section.addr - seg.vmaddr <= seg.vmsize &&
+                    section.size <= seg.vmsize - (section.addr - seg.vmaddr)) annotation = section.addr;
+            }
+        }
+        offset += lc.cmdsize;
+    }
+    if (!have_text || !annotation || base < text_vmaddr) return;
+    uint64_t slide = base - text_vmaddr;
+    if (annotation + slide < annotation) return;
+    uint64_t info[8];
+    if (dreamlte_crash_read(annotation + slide, info, sizeof(info)) || info[0] != 5) return;
+    printf("CRASH %s annotations image 0x%llx version %llu\n", name, base, info[0]);
+    dreamlte_crash_message(name, 1, info[1]);
+    dreamlte_crash_message(name, 2, info[4]);
+}
+
+static void
+dreamlte_crash_annotations(const char *name, uint64_t address, uint64_t size, uint64_t main_image)
+{
+    struct { uint32_t version, count; uint64_t array; } infos;
+    struct { uint64_t base, path, modtime; } images[16];
+    dreamlte_crash_image(name, main_image);
+    if (size < sizeof(infos) || dreamlte_crash_read(address, &infos, sizeof(infos)) ||
+        infos.version < 1 || infos.count > 2048 || !infos.array ||
+        infos.array + (uint64_t)infos.count * sizeof(images[0]) < infos.array) return;
+    unsigned matches = 0;
+    for (unsigned start = 0; start < infos.count; start += 16) {
+        unsigned count = infos.count - start;
+        if (count > 16) count = 16;
+        if (dreamlte_crash_read(infos.array + start * sizeof(images[0]), images,
+            count * sizeof(images[0]))) return;
+        for (unsigned i = 0; i < count; i++) {
+            char path[256];
+            vm_size_t copied = 0;
+            if (images[i].path && copyinstr((user_addr_t)images[i].path, path, sizeof(path), &copied) == 0 &&
+                (!strcmp(path, "/usr/lib/libc++abi.dylib") || !strcmp(path, "/usr/lib/libobjc.A.dylib") ||
+                 !strcmp(path, "/usr/lib/system/libsystem_c.dylib") ||
+                 !strcmp(path, "/System/Library/Frameworks/Foundation.framework/Foundation") ||
+                 !strcmp(path, "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation") ||
+                 !strcmp(path, "/System/Library/Frameworks/QuartzCore.framework/QuartzCore"))) {
+                if (++matches > 6) return;
+                dreamlte_crash_image(name, images[i].base);
+            }
+        }
+    }
+    printf("CRASH %s annotation scan images %u matches %u\n", name, infos.count, matches);
+}
+
+void dreamlte_daemon_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode);
+
+void
+dreamlte_daemon_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subcode)
+{
+	thread_t thread = current_thread();
+	task_t task = current_task();
+	arm_saved_state_t *ss = find_user_regs(thread);
+	uint64_t slide = 0, mh = task->mach_header_vm_address;
+
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("CRASH %s[%d] sig %d code 0x%llx sub 0x%llx slide 0x%llx mh 0x%llx\n",
+	    name, pid, sig, code, subcode, slide, mh);
+	if (ss == NULL || !is_saved_state64(ss)) {
+		return;
+	}
+	dreamlte_crash_annotations(name, task->all_image_info_addr, task->all_image_info_size, mh);
+	uint64_t x19 = saved_state64(ss)->x[19];
+	char message[160];
+	vm_size_t copied = 0;
+	if (x19 != 0 && copyinstr((user_addr_t)x19, message, sizeof(message), &copied) == 0) {
+		bool printable = copied > 1;
+		for (vm_size_t i = 0; i + 1 < copied; i++) {
+			if ((unsigned char)message[i] < 32 || (unsigned char)message[i] > 126) printable = false;
+		}
+		if (printable) printf("CRASH %s x19: %s\n", name, message);
+	}
+	uint64_t fp = get_saved_state_fp(ss);
+	printf("CRASH %s pc 0x%llx lr 0x%llx sp 0x%llx fp 0x%llx far 0x%llx\n", name,
+	    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss), fp,
+	    (uint64_t)saved_state64(ss)->far);
+
+	/* Bound reads to24 frames; six stopped inside the terminate wrappers. */
+	char line[544];
+	int n = snprintf(line, sizeof(line), "CRASH %s bt", name);
+	for (int i = 0; i < 24 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+		uint64_t frame[2];
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	printf("%s\n", line);
+}
+/* Snapshot references/registers while holding task_lock, then drop it before
+ * printing or reading user memory. This is a racy diagnostic, not a debugger. */
+void dreamlte_sample_task(const char *name, int pid, task_t task);
+void
+dreamlte_sample_task(const char *name, int pid, task_t task)
+{
+    struct snapshot { thread_t thread; uint64_t pc, lr, sp, fp; int state; uint64_t wait, cont, kbt[12]; unsigned kn; time_value_t user, system, runnable; } snap[24];
+    unsigned count = 0;
+    vm_map_t map = get_task_map_reference(task);
+    if (map == VM_MAP_NULL) return;
+    uint64_t slide = 0;
+    vm_shared_region_t sr = vm_shared_region_get(task);
+    if (sr != NULL) {
+        slide = sr->sr_slide;
+        vm_shared_region_deallocate(sr);
+    }
+    uint64_t mh;
+    task_lock(task);
+    mh = task->mach_header_vm_address;
+    thread_t thread;
+    queue_iterate(&task->threads, thread, thread_t, task_threads) {
+        if (count == 24) break;
+        arm_saved_state_t *ss = find_user_regs(thread);
+        if (ss == NULL || !is_saved_state64(ss)) continue;
+        thread_reference(thread);
+        snap[count].thread = thread;
+        snap[count].pc = get_saved_state_pc(ss);
+        snap[count].lr = get_saved_state_lr(ss);
+        snap[count].sp = get_saved_state_sp(ss);
+        snap[count].fp = get_saved_state_fp(ss);
+        spl_t old_spl = splsched();
+        thread_lock(thread);
+        snap[count].state = thread->state;
+        snap[count].wait = thread->wait_event;
+        snap[count].cont = (uintptr_t)thread->continuation;
+        snap[count].kn = 0;
+        if ((thread->state & TH_WAIT) && thread->kernel_stack != 0) {
+            arm_kernel_saved_state_t ks;
+            if (ml_nofault_copy((vm_offset_t)&thread_get_kernel_state(thread)->machine.ss,
+                (vm_offset_t)&ks, sizeof(ks)) == sizeof(ks)) {
+                snap[count].kbt[snap[count].kn++] = ks.lr;
+                uint64_t kfp = ks.fp;
+                while (snap[count].kn < 12 && !(kfp & 7) &&
+                    kfp >= thread->kernel_stack &&
+                    kfp - thread->kernel_stack <= kernel_stack_size - 16) {
+                    uint64_t frame[2];
+                    if (ml_nofault_copy(kfp, (vm_offset_t)frame, sizeof(frame)) != sizeof(frame)) break;
+                    snap[count].kbt[snap[count].kn++] = frame[1];
+                    if (frame[0] <= kfp) break;
+                    kfp = frame[0];
+                }
+            }
+        }
+        thread_unlock(thread);
+        splx(old_spl);
+        thread_read_times(thread, &snap[count].user, &snap[count].system, &snap[count].runnable);
+        count++;
+    }
+    task_unlock(task);
+    printf("DREAMLTE SAMPLE %s[%d] slide %llx mh %llx threads %u\n", name, pid, slide, mh, count);
+    for (unsigned t = 0; t < count; t++) {
+        printf("DREAMLTE CPU %s t%u user %d.%06d system %d.%06d runnable %d.%06d\n",
+            name, t, snap[t].user.seconds, snap[t].user.microseconds,
+            snap[t].system.seconds, snap[t].system.microseconds,
+            snap[t].runnable.seconds, snap[t].runnable.microseconds);
+        char line[360];
+        int kn = snprintf(line, sizeof(line), "DREAMLTE WAIT %s t%u event %llx continuation %llx kbt",
+            name, t, snap[t].wait, snap[t].cont);
+        for (unsigned k = 0; k < snap[t].kn && kn < (int)sizeof(line) - 20; k++)
+            kn += snprintf(line + kn, sizeof(line) - kn, " %llx", snap[t].kbt[k]);
+        printf("%s\n", line);
+        int n = snprintf(line, sizeof(line), "DREAMLTE SAMPLE %s t%u state %x pc %llx lr %llx sp %llx bt",
+            name, t, snap[t].state, snap[t].pc, snap[t].lr, snap[t].sp);
+        uint64_t fp = snap[t].fp;
+        for (unsigned i = 0; i < 12 && fp != 0 && !(fp & 7) && n < (int)sizeof(line) - 20; i++) {
+            uint64_t frame[2];
+            if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) break;
+            n += snprintf(line + n, sizeof(line) - n, " %llx", frame[1]);
+            if (frame[0] <= fp) break;
+            fp = frame[0];
+        }
+        printf("%s\n", line);
+        thread_deallocate(snap[t].thread);
+    }
+    vm_map_deallocate(map);
+}
