diff --git a/hfs/catalog.c b/hfs/catalog.c
index 5e58b5b..07c8f56 100644
--- a/hfs/catalog.c
+++ b/hfs/catalog.c
@@ -301,14 +301,32 @@ static BTKey* catalogDataRead(off_t offset, io_func* io) {
 }
 
 void ASCIIToUnicode(const char* ascii, HFSUniStr255* unistr) {
-  int count;
-  
-  count = 0;
-  while(ascii[count] != '\0') {
-    unistr->unicode[count] = ascii[count];
-    count++;
+  /* Paths supplied by the S8 importer are normalized UTF-8, not ASCII. */
+  const unsigned char *p = (const unsigned char *)ascii;
+  unsigned count = 0;
+  while (*p) {
+    uint32_t cp;
+    unsigned more;
+    if (*p < 0x80) { cp = *p++; more = 0; }
+    else if (*p >= 0xc2 && *p <= 0xdf) { cp = *p++ & 0x1f; more = 1; }
+    else if (*p >= 0xe0 && *p <= 0xef) { cp = *p++ & 0x0f; more = 2; }
+    else if (*p >= 0xf0 && *p <= 0xf4) { cp = *p++ & 7; more = 3; }
+    else { fprintf(stderr, "invalid UTF-8 path\n"); exit(1); }
+    unsigned width = more;
+    while (more--) {
+      if ((*p & 0xc0) != 0x80) { fprintf(stderr, "invalid UTF-8 continuation\n"); exit(1); }
+      cp = (cp << 6) | (*p++ & 0x3f);
+    }
+    if ((width == 1 && cp < 0x80) || (width == 2 && cp < 0x800) ||
+        (width == 3 && cp < 0x10000) || cp > 0x10ffff ||
+        (cp >= 0xd800 && cp <= 0xdfff)) { fprintf(stderr, "invalid Unicode scalar\n"); exit(1); }
+    if (count + (cp > 0xffff ? 2 : 1) > 255) { fprintf(stderr, "HFS name too long\n"); exit(1); }
+    if (cp > 0xffff) {
+      cp -= 0x10000;
+      unistr->unicode[count++] = 0xd800 | (cp >> 10);
+      unistr->unicode[count++] = 0xdc00 | (cp & 0x3ff);
+    } else unistr->unicode[count++] = cp;
   }
-  
   unistr->length = count;
 }
 
